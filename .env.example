# Copy to .env (git-ignored). taverna-cli loads it at startup, and real
# environment variables win over it. Every value here is optional in
# development: the defaults in config/development.yaml apply when unset.
# See docs/CONFIGURATION.md for the full list.

DATABASE_URL=postgres://localhost:5432/taverna_development
TEST_DATABASE_URL=postgres://localhost:5432/taverna_test
BASE_URL=http://localhost:3000
TAVERNA_DOMAIN=localhost:3000
JWT_SECRET=dev-secret-change-in-production

# FEDERATION_ENABLED=false
# RATE_LIMITING_ENABLED=true
# TRUSTED_PROXIES=127.0.0.1,::1
# BLOCKED_DOMAINS=spam.example,bad.example
# HTTP_SIGNATURE_EXPIRY_SECONDS=30
